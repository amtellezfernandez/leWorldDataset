{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/worldepisode/schemas/semantic-projection-v0.schema.json",
  "title": "USS / WorldEpisode Semantic Projection Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "status",
    "scope",
    "claim_boundary",
    "field_count",
    "fields",
    "binding_models"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "semantic-projection-v0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "field_count": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "label", "requirement_ids", "description"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+\\.[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "binding_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding",
          "description",
          "native_fields",
          "sidecar_policy",
          "claim_boundary"
        ],
        "properties": {
          "binding": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "native_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
            },
            "uniqueItems": true
          },
          "sidecar_policy": {
            "type": "string",
            "enum": ["all_missing", "listed_only"]
          },
          "sidecar_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
            },
            "uniqueItems": true,
            "default": []
          },
          "claim_boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
